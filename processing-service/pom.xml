<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.kishore.payments</groupId>
    <artifactId>payment-instruction-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>processing-service</artifactId>
  <packaging>jar</packaging>

  <name>processing-service</name>
  <description>Validation, enrichment and routing: carries a RECEIVED instruction to ROUTED, or into the exception path</description>

  <dependencies>
    <dependency>
      <groupId>com.kishore.payments</groupId>
      <artifactId>core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- This service has no HTTP API of its own (spring.main.web-application-type:
         none, see application.yml), only a Kafka consumer and actuator
         endpoints on their own management.server.port. spring-boot-starter-web
         is still required even so: spring-boot-starter-actuator alone provides
         no embeddable HTTP server implementation, so with web-application-type
         none and no web starter, management.server.port was a silent no-op,
         confirmed directly (Part 3, .notes/reports/PHASE-12-REPORT.md section 9):
         the app started and ran its Kafka consumers correctly, logged "Started
         ProcessingServiceApplication", and never opened any server socket at
         all, no error, because there was nothing to fail, just nothing built
         to succeed either. web-application-type none still prevents a main
         web server from starting; this dependency only supplies the embeddable
         server class the separate management context needs. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Phase 10 (.notes/reports/PHASE-10-REPORT.md section 3): the OTel bridge for
         Micrometer Tracing (core already carries the vendor-neutral
         Tracer/Propagator API, see core/pom.xml) plus an OTLP exporter so
         spans reach Jaeger, which speaks OTLP natively. Both auto-configured
         by spring-boot-starter-actuator once present; no explicit
         @Configuration needed. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <!-- Phase 10: nothing scrapes this service's metrics without it: Prometheus
         needs /actuator/prometheus, which spring-boot-starter-actuator alone does
         not expose; this is the registry that renders it. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Reference-data cache (B4): correspondent/nostro/cutoff/business-day
         lookups keyed by refdata version. -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>redpanda</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
            <configuration>
              <!-- Without a classifier, repackage overwrites the plain jar
                   with the executable BOOT-INF/classes/... layout, which
                   integration-tests (a test-scope dependency on this module,
                   see .notes/reports/CROSS-SERVICE-INTEGRATION-DEFECTS.md)
                   cannot compile against. Same fix rail-simulator already
                   uses for the same reason - see that module's own pom.xml. -->
              <classifier>exec</classifier>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
