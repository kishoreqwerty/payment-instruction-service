<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <conversionRule conversionWord="masked"
                     converterClass="com.kishore.payments.intake.logging.SensitiveFieldMaskingConverter" />

    <!-- Plain pattern output for now. Structured JSON output (per
         .notes/ARCHITECTURE.md #5 / the Phase 2 prompt) needs a JSON
         encoder that isn't in this phase's dependency list
         (e.g. net.logstash.logback:logstash-logback-encoder) and is left
         for a follow-up rather than added unlisted. %masked replaces %msg
         so every log line goes through SensitiveFieldMaskingConverter. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{ISO8601} %-5level [%thread] %logger{36} - %masked%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
