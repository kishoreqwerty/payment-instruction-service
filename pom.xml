<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.kishore.payments</groupId>
  <artifactId>payment-instruction-service</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>payment-instruction-service</name>
  <description>Payment instruction processing and exception handling service</description>

  <modules>
    <module>core</module>
    <module>intake-service</module>
    <module>processing-service</module>
    <module>rail-simulator</module>
    <module>settlement-gateway</module>
    <module>exception-service</module>
    <module>integration-tests</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <spring-boot.version>3.2.5</spring-boot.version>
    <testcontainers.version>1.21.4</testcontainers.version>
    <jaxb2-maven-plugin.version>3.3.0</jaxb2-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Imported first so its Testcontainers versions take precedence over
           the older ones bundled in the Spring Boot BOM below (Maven's
           dependency management resolves same-GAV conflicts between
           imported BOMs by first-declared-wins). -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
          <configuration>
            <!-- Mockito 5.7.0 (pinned by the Spring Boot 3.2.5 BOM) bundles
                 a ByteBuddy that doesn't yet recognise newer JDKs than it
                 shipped against; @SpyBean/@MockBean tests fail to create
                 their proxies without this flag. Not a dependency change,
                 just ByteBuddy's own documented opt-in for running against a
                 JDK newer than its official support list. -->
            <argLine>-Dnet.bytebuddy.experimental=true</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <!-- Not part of Spring Boot's dependency-management (that only
             covers dependencies, and even then only through parent
             inheritance, which this multi-module build doesn't use for
             plugins) so its version is pinned explicitly here. -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>jaxb2-maven-plugin</artifactId>
          <version>${jaxb2-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
