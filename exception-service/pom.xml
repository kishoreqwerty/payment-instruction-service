<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.kishore.payments</groupId>
    <artifactId>payment-instruction-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>exception-service</artifactId>
  <packaging>jar</packaging>

  <name>exception-service</name>
  <description>Owns the exception case lifecycle: classification, assignment, repair, maker-checker approval, and terminal rejection or resubmission</description>

  <properties>
    <!-- Phase 11: overridable from the command line (-Dclassifier.live.excludedGroups=), unlike a
         bare hardcoded <excludedGroups>live</excludedGroups>, which -DexcludedGroups= on its own
         cannot override without this indirection. -->
    <classifier.live.excludedGroups>live</classifier.live.excludedGroups>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.kishore.payments</groupId>
      <artifactId>core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Phase 10 (.notes/reports/PHASE-10-REPORT.md section 3): the OTel bridge for
         Micrometer Tracing (core already carries the vendor-neutral
         Tracer/Propagator API, see core/pom.xml) plus an OTLP exporter so
         spans reach Jaeger, which speaks OTLP natively. Both auto-configured
         by spring-boot-starter-actuator once present; no explicit
         @Configuration needed. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <!-- Phase 10: nothing scrapes this service's metrics without it: Prometheus
         needs /actuator/prometheus, which spring-boot-starter-actuator alone does
         not expose; this is the registry that renders it. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Phase 11 (.notes/reports/PHASE-11-REPORT.md): the exception classifier's own model
         client. Named per CLAUDE.md's dependency rule: the phase brief explicitly specifies
         "Anthropic Java SDK" for ClassifierClient. -->
    <dependency>
      <groupId>com.anthropic</groupId>
      <artifactId>anthropic-java</artifactId>
      <version>2.57.0</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>redpanda</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <!-- Same reasoning as settlement-gateway/pom.xml and
               .notes/reports/PHASE-5-REPORT.md section 4: without this,
               Spring's @PathVariable name resolution breaks once javac
               erases parameter names, and this module's REST surface
               leans on it throughout. -->
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Phase 11 (.notes/reports/PHASE-11-REPORT.md): tests tagged "live" make a real,
               billed call to the Anthropic API and are excluded from every normal run (including
               CI) so this module never requires ANTHROPIC_API_KEY to build. Run them explicitly
               with -Dgroups=live -DexcludedGroups= when a key is available and you want to verify
               the client against the real API, not just against the fake endpoints the rest of
               ClassifierClientTest uses. -->
          <excludedGroups>${classifier.live.excludedGroups}</excludedGroups>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
            <configuration>
              <!-- Without a classifier, repackage overwrites the plain jar
                   with the executable BOOT-INF/classes/... layout, which
                   integration-tests (a test-scope dependency on this module,
                   see .notes/reports/CROSS-SERVICE-INTEGRATION-DEFECTS.md)
                   cannot compile against. Same fix rail-simulator already
                   uses for the same reason - see that module's own pom.xml. -->
              <classifier>exec</classifier>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
